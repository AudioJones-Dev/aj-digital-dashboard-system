# aj-digital-dashboard-system — environment
# Hub runs on this port (npm/pnpm dev → next dev -p 7500)
HUB_PORT=7500

# Local dev is open by default even if Clerk keys exist. Set HUB_LOCAL_OPEN=false
# or HUB_AUTH_MODE=clerk when you want to test Clerk-protected routes locally.
HUB_LOCAL_OPEN=true

# Command execution is display-only by default. Enable only after reviewing each
# project's /api/run security boundary.
NEXT_PUBLIC_ENABLE_COMMAND_RUNNER=false

# No secrets are required for local read-only hub mode. It reads each project's
# /api/data and /api/manifest over loopback.
